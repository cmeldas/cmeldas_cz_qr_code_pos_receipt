<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- QR kód platby pod platebními řádky, před patičkou účtenky -->
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <t t-foreach="paymentLines" t-as="line" t-key="line_index">
                <div t-if="line.qr_code" class="pos-receipt-qr-code text-center pt-3">
                    <div class="fw-bolder">QR kód pro platbu</div>
                    <img t-att-src="line.qr_code"
                         style="max-width: 200px; width: 100%; height: auto;"
                         alt="QR kód pro platbu"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
